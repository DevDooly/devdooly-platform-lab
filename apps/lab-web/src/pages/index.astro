---
import LabExplorer from '../components/LabExplorer';
import FirstVisitTour from '../components/FirstVisitTour.astro';
import PortfolioIntroduction from '../components/PortfolioIntroduction.astro';
import ServiceDirectory from '../components/ServiceDirectory.astro';
import TourStepNavigation from '../components/TourStepNavigation';
import InitialFragment from '../components/InitialFragment.astro';
import { publicApiConfiguration } from '../lib/public-api-base';
import EvidenceExplorer from '../components/EvidenceExplorer';
import PlatformObservationCard from '../components/PlatformObservationCard';
import GitHubAppRenewalCard from '../components/GitHubAppRenewalCard.astro';
import TlsCertificateObservation from '../components/TlsCertificateObservation.astro';
import tlsCertificate from '../data/tls-certificate.generated.json';
import { buildTlsHistory } from '../lib/tls-certificate-history';
import JobObservationCard from '../components/JobObservationCard';
import KafkaObservationCard from '../components/KafkaObservationCard';
import KafkaLagRecoveryCard from '../components/KafkaLagRecoveryCard';
import kafkaLagRecovery from '../data/kafka-lag-recovery.generated.json';
import OffsetCommitRecoveryCard from '../components/OffsetCommitRecoveryCard';
import offsetCommitRecovery from '../data/offset-commit-recovery.generated.json';
import ExportIntegrityRuntimeCard from '../components/ExportIntegrityRuntimeCard';
import exportIntegrityRuntime from '../data/export-integrity-runtime.generated.json';
import AiWindowCase from '../components/AiWindowCase';
import WorkerReadinessProof from '../components/WorkerReadinessProof.astro';
import IcebergDataflowCard from '../components/IcebergDataflowCard';
import SparkTrialCard from '../components/SparkTrialCard';
import CloudLakehouseCard from '../components/CloudLakehouseCard';
import SnapshotExpirationPanel from '../components/SnapshotExpirationPanel.astro';
import IcebergCaptureCard from '../components/IcebergCaptureCard';
import IcebergPolicyScenarios from '../components/IcebergPolicyScenarios';
import icebergPolicyScenarios from '../data/iceberg-policy-scenarios.generated.json';
import CurrentDbRestoreCard from '../components/CurrentDbRestoreCard.astro';
import S3TransportCard from '../components/S3TransportCard';
import '../styles/global.css';
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const apiConfiguration = publicApiConfiguration(import.meta.env.PUBLIC_API_BASE_URL);
const apiBase = apiConfiguration.apiBase;
const preferLive = apiConfiguration.externalHttps;
const jobObservationMode = apiConfiguration.invalid ? 'recorded' : (preferLive || import.meta.env.BASE_URL === '/' ? 'api' : 'recorded');
const github = 'https://github.com/DevDooly/devdooly-platform-lab';
const tlsReviewed = [{
  runUrl: `${github}/actions/runs/39452152238`,
  sourceCommit: '8c17642ad4c38a6f0edd3fb47dafa4ec5a431723',
  artifactSha256: '72c806703547c2fb30a1e9a7e15b1baf41cddc88cc6318ef5589f7c24c69a157',
  rawSummaryUrl: `${github}/blob/391c58bf9ede2a018b56d10c4c3ddbe92d27e8c0/docs/evidence/tls-certificate/hosted-39452152238/summary.json`,
}, {
  runUrl: `${github}/actions/runs/39477022262`,
  sourceCommit: '6f551a16a8ed536bb126403234c41b9e9b266d43',
  artifactSha256: '8c80681035f3e8f87d18eed2d84577f999e71cada2f6a361d2a727559c75e39f',
  rawSummaryUrl: `${github}/blob/73f068c129cb65d65f198b094a482c421e0ffc9b/docs/evidence/tls-certificate/hosted-39477022262/summary.json`,
}];
const tlsHistory = buildTlsHistory(tlsCertificate.entries, tlsReviewed.map(({ runUrl, sourceCommit, artifactSha256 }) => ({ runUrl, sourceCommit, artifactSha256 })), Date.now());
const tlsRawSummaryUrl = tlsReviewed.find(record => record.runUrl === tlsHistory.lastSuccess?.runUrl)?.rawSummaryUrl ?? null;
const skills = [
  { index: '01', title: 'Java & Spring Boot', description: '반도체 제조 데이터 ETL 서비스를 개발하고 운영합니다. 레거시 코드의 오류와 프로젝트 구조를 꾸준히 개선해 왔습니다.', tags: ['Backend', 'ETL', 'Code quality'] },
  { index: '02', title: 'Data & Messaging', description: 'Kafka의 오류를 분석하고 버전 업그레이드를 진행했습니다. Hadoop, Tez·Trino, Iceberg 기반 데이터 처리 경험을 연결합니다.', tags: ['Kafka', 'Hadoop', 'Iceberg'] },
  { index: '03', title: 'Delivery & Operation', description: 'Jenkins CI와 Argo CD 기반 CD를 구성·수정하며, Kubernetes·MinIO 운영과 Helm 차트 작성 및 배포를 담당합니다.', tags: ['Kubernetes', 'Helm', 'GitOps'] },
];
const steps = [
  { number: '00', title: '환경과 데이터 먼저 확인', text: '기존 서비스와 포트·데이터 경로를 점검하고 별도 Lab의 설치 범위를 정했습니다.', state: '점검 완료', tone: 'active' },
  { number: '01', title: '작은 API와 조회 화면', text: '고정 seed 합성 데이터, Spring Boot 조회 API와 Astro·React 화면을 연결합니다.', state: 'MVP 구현', tone: 'active' },
  { number: '02', title: '빌드부터 배포까지', text: '같은 소스 SHA의 Jenkins·Actions 검증 후 이미지 게시와 Argo CD·Helm 배포를 연결했습니다. 검증 기록은 위 CI/CD 근거에서 확인합니다.', state: '실제 배포', tone: 'active' },
  { number: '03', title: '외부에서도 읽을 수 있게', text: 'DuckDNS 기반 HTTPS 조회 6개와 경로·Origin·method 거부 3개를 GitHub 외부 runner에서 확인했습니다.', state: 'HTTPS 검증 완료', tone: 'active' },
  { number: '04', title: '메시징과 객체 저장소', text: 'Kafka·Garage·상시 worker를 배포하고 파일 저장 확인, 재시작과 격리 복원을 검증했습니다.', state: '배포·검증', tone: 'active' },
  { number: '05', title: 'AI 개선 사례', text: '개인 Java 시간창 예제로 UTC 오류를 재현·수정하고, 같은 답을 구하는 두 알고리즘의 JMH 측정 기록을 공개합니다. 사람 검토는 대기 중입니다.', state: '로컬 재현·측정', tone: 'active' },
  { number: '06', title: '데이터 플랫폼 확장', text: 'Iceberg·Trino의 시점 조회와 정상 재시작 후 보존을 검증했습니다. 별도 GitHub 격리 실행기에서 Spark 분류·순차 재처리, 파일 compaction과 같은 warehouse의 Trino 조회를 확인했습니다.', state: '부분 실증', tone: 'active' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f0" />
    <InitialFragment />
    <title>DevDooly — Java·데이터·플랫폼 설계 포트폴리오</title>
    <meta name="description" content="개발자 김선홍의 Java·데이터·플랫폼 포트폴리오. 기술별 설계와 실제 화면, 구현 근거, 학습 및 다른 환경의 재구축 방법을 연결합니다." />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 이동</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href="#" aria-label="DevDooly Platform Lab 처음으로"><svg aria-hidden="true" viewBox="0 0 36 36"><path d="M18 0v36M0 18h36M5.3 5.3l25.4 25.4M5.3 30.7 30.7 5.3" stroke="currentColor" stroke-width="6"/></svg><span>DevDooly<strong>PLATFORM LAB</strong></span></a>
      <nav aria-label="주 메뉴"><a href={`${assetBase}technologies/`}>기술과 설계</a><a href={`${assetBase}guides/rebuild/`}>학습·재구축</a><a href="#services">서비스 목차</a><a href="#lab">실행 결과</a><a href="#about">개발자 소개</a></nav>
      <a class="header-github" href={github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div></header>
    <main id="main">
      <section class="hero section" aria-labelledby="hero-title"><div class="hero-copy">
        <div class="hero-eyebrow"><span class="eyebrow">KIM SEONHONG / ENGINEERING PORTFOLIO</span><span class="tag"><i/>개인 Lab</span></div>
        <h1 id="hero-title">코드에서 데이터로,<br/><span>배포와 운영까지.</span></h1>
        <p class="hero-description">안녕하세요, 개발자 김선홍입니다.<br/>Java·데이터·플랫폼 업무 경험을 작은 시스템으로 연결했습니다. 어떤 문제를 풀었는지, 왜 이 기술을 선택했는지, 실제로 어디까지 검증했는지 보여드립니다.</p>
        <div class="hero-actions"><a class="button button-primary" href={`${assetBase}technologies/`}>기술과 설계 둘러보기 <span aria-hidden="true">→</span></a><a class="text-link" href="#services">실제 서비스 열기 <span aria-hidden="true">↓</span></a></div>
        <div class="hero-footnote"><span class="line"/><span>BACKEND · DATA · PLATFORM</span><span class="edition">VOL. 01 / WORK IN PROGRESS</span></div>
      </div><div class="hero-visual" aria-label="소스 코드에서 관측 가능한 서비스로 이어지는 프로젝트 구조">
        <div class="visual-topline"><span>THE WORKBENCH</span><span>↗</span></div>
        <div class="visual-title">작게 구축하고,<br/>설계의 이유를 남깁니다.</div>
        <div class="system-diagram"><div class="system-node source-node"><span class="node-icon">&#123; &#125;</span><div><small>BUILD SOMETHING</small><strong>Java / Spring Boot</strong></div><span class="node-code">01</span></div><div class="node-connector"><span/>validate → persist → inspect</div><div class="diagram-branches"><div class="system-node mini-node"><span class="node-icon">≋</span><small>SYNTHETIC DATA</small><strong>결과와 실패 사유</strong></div><div class="system-node mini-node"><span class="node-icon">⌁</span><small>DELIVERY</small><strong>빌드와 배포 근거</strong></div></div><div class="node-connector bottom-connector"><span/></div><div class="system-node observe-node"><span class="node-icon">◎</span><div><small>MAKE IT VISIBLE</small><strong>Platform Lab</strong></div><span class="small-tag">READ ONLY</span></div></div>
        <div class="visual-bottom"><span class="bracket">[</span><p>결과뿐 아니라<br/>왜 그렇게 동작하는지까지.</p><span class="visual-star" aria-hidden="true">✳</span><span class="bracket">]</span></div>
      </div></section>
      <PortfolioIntroduction />
      <ServiceDirectory adminUrls={{ jenkins: 'https://jenkins.devdooly-platform-lab.duckdns.org/', argocd: 'https://argocd.devdooly-platform-lab.duckdns.org/', kafka: 'https://kafka.devdooly-platform-lab.duckdns.org/' }} verifiedAt="2026-10-24 09:03 KST" />
      <FirstVisitTour />
      <section id="about" class="section experience-section" aria-labelledby="experience-title"><div class="section-heading"><div><span class="eyebrow">01 / EXPERIENCE INTO EVIDENCE</span><h2 id="experience-title">실무에서 다룬 기술, 직접 확인할 수 있는 기록.</h2></div><a class="text-link" href="https://github.com/DevDooly" target="_blank" rel="noreferrer">개발 기록 더 보기 ↗</a></div><div class="experience-grid">{skills.map(skill => <article class="experience-item"><span class="experience-number">{skill.index}</span><h3>{skill.title}</h3><p>{skill.description}</p><div class="skill-tags">{skill.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div><div class="ai-note"><span class="ai-symbol" aria-hidden="true">✳</span><div><h3>AI와 함께 읽고, 개발자의 판단으로 개선합니다.</h3><p>LLM을 레거시 코드 분석과 버그 수정에 적극 활용합니다. 아래 개인 합성 예제에서는 시간대 오류 수정과 계산 복잡도 개선을 독립 테스트·JMH로 확인하며, 실무 성과와 구분합니다.</p><a class="text-link" href="#ai-window">개인 예제와 검증 기록 보기 ↗</a></div><span class="tag">개인 예제 · 사람 검토 대기</span></div></section>
      <EvidenceExplorer client:load />
      <LabExplorer client:load apiBase={apiBase} observationUrl={`${assetBase}data/lab-observation.json`} basePath={assetBase}/>
      <JobObservationCard client:load apiBase={apiBase} observationUrl={`${assetBase}observations/jobs.latest.json`} mode={jobObservationMode} preferLive={preferLive} basePath={assetBase}/>
      <KafkaObservationCard client:load apiBase={apiBase} observationUrl={`${assetBase}observations/kafka.latest.json`} mode={jobObservationMode} preferLive={preferLive}/>
      <KafkaLagRecoveryCard client:load record={kafkaLagRecovery}/>
      <TourStepNavigation step={2}/>
      <OffsetCommitRecoveryCard client:load record={offsetCommitRecovery}/>
      <ExportIntegrityRuntimeCard client:load record={exportIntegrityRuntime}/>
      <WorkerReadinessProof />
      <PlatformObservationCard client:load observationUrl={`${assetBase}data/platform-observation.json`}/>
      <GitHubAppRenewalCard />
      <TlsCertificateObservation view={tlsHistory} rawSummaryUrl={tlsRawSummaryUrl}/>
      <AiWindowCase client:load observationUrl={`${assetBase}observations/ai-window.latest.json`}/>
      <TourStepNavigation step={4}/>
      <IcebergDataflowCard client:load observationUrl={`${assetBase}observations/iceberg.latest.json`}/>
      <SparkTrialCard client:load observationUrl={`${assetBase}observations/spark.latest.json`}/>
      <CloudLakehouseCard client:load observationUrl={`${assetBase}observations/cloud-lakehouse.latest.json`}/>
      <SnapshotExpirationPanel />
      <IcebergCaptureCard client:load observationUrl={`${assetBase}evidence/iceberg-capture/summary.json`}/>
      <TourStepNavigation step={5}/>
      <IcebergPolicyScenarios client:load bundle={icebergPolicyScenarios}/>
      <CurrentDbRestoreCard />
      <S3TransportCard client:load observationUrl={`${assetBase}observations/s3.latest.json`}/>
      <section id="progress" class="section progress-section" aria-labelledby="progress-title"><div class="progress-intro"><span class="eyebrow">04 / BUILD IN THE OPEN</span><h2 id="progress-title">구축 과정도<br/>기록합니다.</h2><p>이곳은 개인 Lab의 첫 버전입니다.<br/>실무 경험과 새로 구축하는 환경을 구분하고,<br/>검증한 결과만 기록합니다.</p><a class="text-link" href={`${github}/blob/main/docs/ROADMAP.md`} target="_blank" rel="noreferrer">전체 진행 목록 ↗</a></div><div class="progress-list">{steps.map(step => <article class="progress-step"><span class="step-number">{step.number}</span><div><h3>{step.title}</h3><p>{step.text}</p></div><span class={`step-state ${step.tone}`}>{step.state}</span></article>)}</div></section>
      <section class="section notes-section" aria-label="기술 문서와 소스 코드"><div><span class="eyebrow">THE NOTES BEHIND THE WORK</span><h2>코드 옆에, 이유를 남깁니다.</h2><p>문제를 이해하고 선택한 방법, 검증한 과정은 문서에서 이어집니다.</p></div><div class="notes-links"><a href="#db-restore"><div><small>RECOVERY VALIDATION</small><strong>DB 복원과 전체 내용 비교</strong></div><span aria-hidden="true">↗</span></a><a href="https://devdooly.github.io/TIL/" target="_blank" rel="noreferrer"><div><small>TECHNICAL WIKI</small><strong>TIL · 매일의 기술 기록</strong></div><span aria-hidden="true">↗</span></a><a href={`${github}/tree/main/docs`} target="_blank" rel="noreferrer"><div><small>PROJECT DOCUMENTS</small><strong>설계 결정과 검증 기록</strong></div><span aria-hidden="true">↗</span></a><a href={`${github}/blob/main/docs/evidence/input-concurrency-load/README.md`} target="_blank" rel="noreferrer"><div><small>ISOLATED VALIDATION</small><strong>최대 1,000개 · 동시 접수 검증</strong></div><span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer"><div><span class="footer-name">DevDooly <span>김선홍</span></span><p>실무 경험에서 출발한 개인 플랫폼. 모든 예제는 합성 데이터로 구성합니다.</p></div><a href="#main">BACK TO TOP ↑</a></footer>
  </body>
</html>
