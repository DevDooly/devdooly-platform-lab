---
import ApiConsole from '../components/ApiConsole';
import { publicApiConfiguration } from '../lib/public-api-base';
import '../styles/global.css';
import '../styles/api-console.css';
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const apiBase = publicApiConfiguration(import.meta.env.PUBLIC_API_BASE_URL).apiBase;
const repo = 'https://github.com/DevDooly/devdooly-platform-lab';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f0" />
    <title>Java API 직접 조회 — DevDooly Platform Lab</title>
    <meta name="description" content="Spring Boot 공개 GET API 6개의 설명과 응답 구조를 읽고, 버튼으로 실제 JSON 응답을 확인하는 조회 전용 API 안내입니다." />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 이동</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href={assetBase} aria-label="DevDooly Platform Lab 처음으로"><svg aria-hidden="true" viewBox="0 0 36 36"><path d="M18 0v36M0 18h36M5.3 5.3l25.4 25.4M5.3 30.7 30.7 5.3" stroke="currentColor" stroke-width="6"/></svg><span>DevDooly<strong>PLATFORM LAB</strong></span></a>
      <nav aria-label="API 안내 메뉴"><a href={`${assetBase}#services`}>서비스 목차</a><a href="#api-list">API 목차</a><a href={`${assetBase}#lab`}>결과 시각화</a></nav>
    </div></header>
    <main id="main" class="api-guide">
      <div class="api-guide-intro">
        <a class="text-link" href={`${assetBase}#services`}>← 설치된 서비스와 진행 상태</a>
        <p class="eyebrow">JAVA / SPRING BOOT / PUBLIC GET API</p>
        <h1>설명을 읽고,<br />실제 응답을 확인하세요.</h1>
        <p class="api-guide-lead">실행 결과부터 Kafka 관측까지, 공개된 여섯 개의 조회 API를 한곳에 모았습니다. 궁금한 항목에서 GET 버튼을 눌러 현재 응답을 확인할 수 있습니다.</p>
        <p>로그인 정보나 토큰 없이 공개 합성 데이터만 읽습니다. 작업 실행·파일 변경·관리 기능은 제공하지 않습니다. HTTP 상태와 응답 시각을 함께 확인해주세요.</p>
        <div class="api-guide-source"><a href={`${assetBase}#lab`}>차트와 표로 결과 보기</a><a href={`${repo}/tree/main/apps/api/src/main/java/io/github/devdooly/platformlab`} target="_blank" rel="noreferrer">Spring Boot 소스 ↗</a></div>
      </div>
      <section id="api-list" aria-label="공개 API 설명과 직접 조회">
        <ApiConsole apiBase={apiBase} client:load />
      </section>
    </main>
  </body>
</html>
