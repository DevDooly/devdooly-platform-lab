---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { technologies, type TechnologyGuide } from '../../data/technologyGuides';
import { technologyScreens } from '../../data/technologyScreens';
export function getStaticPaths() { return technologies.map(tech => ({params:{slug:tech.slug},props:{tech}})); }
interface Props { tech: TechnologyGuide; }
const {tech} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/DevDooly/devdooly-platform-lab';
const reference = 'bb53eadf4d189ae1ff357493e194c24a91df70ad';
const screen = technologyScreens[tech.slug];
const consoles: Record<string,{label:string,url:string}> = {
  jenkins:{label:'Jenkins 로그인 화면',url:'https://jenkins.devdooly-platform-lab.duckdns.org/'},
  kubernetes:{label:'Argo CD 로그인 화면',url:'https://argocd.devdooly-platform-lab.duckdns.org/'},
  kafka:{label:'Kafbat UI · 로그인 필요',url:'https://kafka.devdooly-platform-lab.duckdns.org/'},
};
const consoleLink=consoles[tech.slug];
---
<GuideLayout title={tech.title} description={tech.summary} eyebrow={tech.category}>
  <nav class="guide-toc" aria-label="이 기술 페이지 목차"><a href="#why">문제와 선택</a><a href="#flow">구성 흐름</a><a href="#screen">실제 화면</a><a href="#settings">설정과 이식</a><a href="#learn">학습 순서</a><a href="#sources">코드와 근거</a></nav>
  <div class="tech-page-grid">
    <aside class="tech-sidebar">
      <nav class="tech-desktop-nav" aria-label="다른 기술 안내"><a href={`${base}technologies/`}>← 기술 전체 목차</a>{technologies.map(item => <a href={`${base}technologies/${item.slug}/`} aria-current={item.slug===tech.slug?'page':undefined}>{item.title}</a>)}</nav>
      <details class="tech-mobile-nav"><summary>다른 기술 목차 · 8개</summary><nav aria-label="다른 기술 안내"><a href={`${base}technologies/`}>← 기술 전체 목차</a>{technologies.map(item => <a href={`${base}technologies/${item.slug}/`} aria-current={item.slug===tech.slug?'page':undefined}>{item.title}</a>)}</nav></details>
    </aside>
    <div class="tech-content">
      <section id="why" class="guide-section" aria-labelledby="why-title"><h2 id="why-title">문제와 선택</h2><div class="tech-question"><h3>해결하려는 문제</h3><p>{tech.problem}</p></div><div class="tech-question"><h3>이 Lab의 설계</h3><p>{tech.design}</p></div><p class="guide-callout"><strong>구현·검증 범위</strong>{tech.scope}</p></section>
      <section id="flow" class="guide-section" aria-labelledby="flow-title"><h2 id="flow-title">어떻게 연결되어 있나</h2><ol class="tech-flow">{tech.flow.map(step=><li>{step}</li>)}</ol><a class="text-link" href={`${base}technologies/#architecture`}>전체 시스템에서 위치 보기 →</a></section>
      <section id="screen" class="guide-section" aria-labelledby="screen-title"><h2 id="screen-title">화면으로 이해하기</h2><p>공개 포트폴리오의 실제 화면을 2026-10-26(KST)에 캡처했습니다. 이미지 속 기록의 원 시각과 검증 범위는 그대로 읽어주세요.</p>
        {screen && <figure class="tech-screenshot"><a href={`${base}images/technologies/${screen.file}`} target="_blank" rel="noreferrer" aria-label={`${tech.title} 스크린샷 원본 크게 보기, 새 창`}><img src={`${base}images/technologies/${screen.file}`} alt={screen.caption} loading="lazy" width="1265" height="712" /></a><figcaption>{screen.caption} 이미지를 누르면 원본을 크게 볼 수 있습니다.</figcaption></figure>}
        <div class="guide-links">{screen && <a href={`${base}${screen.path}`}>해당 화면 직접 열기 →</a>}{consoleLink && <a href={consoleLink.url} target="_blank" rel="noreferrer">{consoleLink.label} ↗</a>}<a href={`${base}#services`}>전체 서비스 접속 목차 →</a></div>
        {consoleLink && <p class="section-lead">관리 UI에는 본인 계정으로 로그인합니다. 공개 관측 캡처와 관리 화면은 다르며, 링크 자체는 현재 접속 성공을 뜻하지 않습니다.</p>}
      </section>
      <section id="settings" class="guide-section" aria-labelledby="settings-title"><h2 id="settings-title">설정의 의미와 다른 환경으로 옮길 때</h2><p class="section-lead">핵심 설정을 먼저 이해하고 아래 소스에서 전체 구성을 확인하세요. 이 표만으로 새 운영 환경의 설치가 끝나지는 않습니다.</p><div class="tech-settings">{tech.settings.map(setting=><article class="tech-setting"><h3>{setting.name}</h3><p>{setting.purpose}</p><p><strong>이식할 때</strong> · {setting.portability}</p></article>)}</div><div class="guide-links"><a href={`${base}guides/rebuild/`}>실행 명령·환경별 변경표로 이어가기 →</a></div></section>
      <section id="learn" class="guide-section" aria-labelledby="learn-title"><h2 id="learn-title">직접 학습하는 순서</h2><ol class="guide-reading">{tech.learn.map(item=><li>{item}</li>)}</ol><div class="guide-links">{tech.related.map(slug=>{const item=technologies.find(candidate=>candidate.slug===slug);return item && <a href={`${base}technologies/${slug}/`}>{item.title} →</a>;})}</div></section>
      <section id="sources" class="guide-section" aria-labelledby="sources-title"><h2 id="sources-title">코드와 검증 근거</h2><p class="section-lead">설명 기준 소스는 <a href={`${repo}/tree/${reference}`}>bb53ead</a>입니다. 저장소 소스와 실제 운영 image/source pin은 다를 수 있습니다.</p><div class="tech-sources">{[{title:'구현·설정 읽기',links:tech.sources},{title:'실제로 확인한 결과',links:tech.evidence}].map(group=><div><h3>{group.title}</h3><ul>{group.links.map(link=><li><a href={`${repo}/blob/${reference}/${link.path}`} target="_blank" rel="noreferrer">{link.label} ↗</a><small>{link.path}</small></li>)}</ul></div>)}</div></section>
    </div>
  </div>
</GuideLayout>
