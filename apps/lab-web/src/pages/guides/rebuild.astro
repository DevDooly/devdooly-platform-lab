---
import GuideLayout from '../../layouts/GuideLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repository = 'https://github.com/DevDooly/devdooly-platform-lab';
const source = (path: string) => `${repository}/blob/main/${path}`;
const commands = {
  clone: `git clone https://github.com/DevDooly/devdooly-platform-lab.git platform-lab-learning
cd platform-lab-learning`,
  api: `cd apps/api
./mvnw verify
./mvnw spring-boot:run -Dspring-boot.run.profiles=local-dev`,
  apiWindows: `cd apps/api
.\\mvnw.cmd verify
.\\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=local-dev"`,
  web: `cd apps/lab-web
npm ci
npm run check
npm test
npm run dev`,
  compose: `python3 infra/scripts/prepare-local-env.py
docker compose -p platform-lab-learning --env-file .local/compose.env config --quiet
docker compose -p platform-lab-learning --env-file .local/compose.env up --build -d
docker compose -p platform-lab-learning --env-file .local/compose.env ps`,
  stop: `docker compose -p platform-lab-learning --env-file .local/compose.env down`,
  render: `helm lint infra/charts/platform-lab --strict --kube-version 1.36.5 --values infra/charts/platform-lab/ci/lint-values.yaml
helm template lab infra/charts/platform-lab --namespace platform-lab --kube-version 1.36.5 --values infra/charts/platform-lab/ci/lint-values.yaml`,
};
const settings = [
  { name: '브라우저 → API', keys: 'PUBLIC_API_BASE_URL · API_PROXY_TARGET', explanation: '공개 빌드와 개발 proxy를 구분합니다. 공개 주소는 HTTPS·기본 443·DNS 호스트와 /api 또는 /platform-lab/api 경로만 허용합니다. 다른 경로·포트는 public-api-base.ts도 수정해야 합니다. CORS를 맞추고 PUBLIC_ 값에는 비밀을 넣지 않습니다.', file: 'apps/lab-web/.env.example' },
  { name: '정적 사이트 주소', keys: 'SITE_URL · SITE_BASE', explanation: '새 도메인과 저장소 하위 경로에 맞춥니다. 예: SITE_URL=https://example.com, SITE_BASE=/my-lab/. 루트 배포라면 SITE_BASE=/입니다.', file: 'apps/lab-web/astro.config.mjs' },
  { name: 'DB 연결', keys: 'DB_URL · DB_USERNAME · DB_PASSWORD', explanation: '새 전용 DB·계정을 준비합니다. Spring 표준 SPRING_DATASOURCE_* 값으로도 지정할 수 있습니다. 기존 데이터의 비밀번호는 환경변수만 바꾼다고 교체되지 않습니다.', file: 'apps/api/src/main/resources/application.yml' },
  { name: '실행 출처', keys: 'SOURCE_COMMIT · IMAGE_DIGEST', explanation: '실제로 실행하는 이미지의 소스와 digest를 주입합니다. 기반 JDK 이미지 digest를 앱 이미지 digest로 쓰지 않습니다. 미설정은 미관측으로 남깁니다.', file: 'infra/charts/platform-lab/values.yaml' },
  { name: '메시지·객체 저장소', keys: 'runtime.worker.topic · group · bucket · region', explanation: '새 프로젝트 전용 topic·consumer group·bucket을 정합니다. Kafka cluster ID와 Garage layout·키는 데이터 수명과 연결되므로 매 기동마다 재생성하지 않습니다.', file: 'infra/charts/platform-lab/README.md' },
];
const migrations = [
  { title: '저장소·이미지 경로', detail: 'fork의 repoURL, AppProject sourceRepos, registry repository와 CI 권한을 함께 변경합니다. 검증한 앱 digest와 source commit을 환경별로 연결합니다.', files: ['gitops/bootstrap/application.yaml', 'gitops/bootstrap/project.yaml', 'gitops/environments/home-lab/values.yaml'] },
  { title: '대상 클러스터·namespace', detail: 'Argo CD destination과 전용 namespace를 맞춥니다. 현재 chart는 namespace당 release 하나와 cluster.local DNS를 전제로 합니다. 다른 클러스터 도메인은 template까지 수정해야 합니다.', files: ['gitops/bootstrap/application.yaml', 'infra/charts/platform-lab/templates/web-deployment.yaml'] },
  { title: '디스크·자원·복제 수', detail: '현재 schema는 local-path 저장소와 replica 1을 제한합니다. 다른 StorageClass·다중 노드는 값만 교체할 수 없고 schema·template·검증을 함께 바꿔야 합니다. PVC 요청량은 디스크 강제 quota가 아닙니다.', files: ['infra/charts/platform-lab/values.schema.json', 'infra/charts/platform-lab/values.yaml'] },
  { title: 'Secret·관리자 로그인', detail: 'DB·S3·registry·GitHub App 자격증명은 새 환경에 별도로 준비합니다. chart는 기존 Secret을 참조하며 비밀을 생성하지 않습니다. 개인키·비밀번호를 values나 프런트 빌드에 복사하지 않습니다.', files: ['infra/charts/platform-lab/README.md', 'docs/evidence/github-app-jenkins/README.md'] },
  { title: '도메인·TLS·외부 접속', detail: 'DNS, 인증서 발급, reverse proxy, 공개 GET 경로와 관리자 인증을 새 환경에서 검증합니다. 현재 chart의 ingress.enabled는 false만 허용하며 도메인 변경만으로 외부 접속이 완성되지 않습니다.', files: ['infra/public-gateway/README.md', 'docs/evidence/public-read-https/README.md'] },
];
---

<GuideLayout title="작게 실행하고, 이해한 만큼 옮깁니다." description="작은 로컬 실행에서 시작해 DB·Kafka·객체 저장소와 GitOps로 확장하는 순서, 환경별로 바꿔야 하는 설정을 안내합니다." eyebrow="REBUILD PLAYBOOK">
  <article class="rebuild-guide">
    <div class="rebuild-intro">
      <div class="intro-links"><a href={`${base}technologies/`}>기술별 구성 먼저 보기 <span aria-hidden="true">↗</span></a><a href={`${base}api-guide/`}>공개 API 살펴보기 <span aria-hidden="true">↗</span></a></div>
      <p class="scope-note">명령은 새 학습용 checkout에서 실행하는 안내입니다. 이 문서를 추가하면서 현재 미니 PC의 서비스·데이터·운영 이미지 pin을 변경하지 않았습니다.</p>
    </div>

    <nav class="route-map" aria-label="재구축 학습 순서">
      <a href="#local"><span>01</span><strong>로컬에서 이해하기</strong><small>Java API + React 화면</small></a>
      <a href="#expand"><span>02</span><strong>상태와 재전달 배우기</strong><small>MariaDB → Kafka + Garage</small></a>
      <a href="#migrate"><span>03</span><strong>새 환경으로 이식하기</strong><small>이미지 → Helm → Argo CD</small></a>
    </nav>

    <section id="local" class="phase" aria-labelledby="local-heading">
      <div class="phase-heading"><span class="phase-number">01</span><div><p class="kicker">가장 작은 시작점</p><h2 id="local-heading">DB 서버 없이 요청과 결과부터 봅니다.</h2></div></div>
      <p>Java 21과 <strong>Node 24 계열</strong> 또는 <strong>Node 22.12 이상 22 계열</strong>, Git이 필요합니다. Maven은 저장소의 Wrapper를 사용합니다. 설치 버전을 임의로 올리기보다 <a href={source('apps/api/pom.xml')}>pom.xml</a>과 <a href={source('apps/lab-web/package-lock.json')}>package-lock.json</a>에 고정된 조합부터 재현하세요.</p>
      <div class="command" data-command-block><div class="command-header"><span>처음 한 번 · 새 폴더 만들기</span><button type="button" data-copy-command aria-label="저장소 복제 명령 복사">복사</button></div><pre><code>{commands.clone}</code></pre><p class="copy-status" aria-live="polite"></p></div>
      <div class="split">
        <div class="step-card"><h3>터미널 A · API</h3><p>저장소 루트에서 시작합니다. <code>local-dev</code>는 H2 파일 DB를 <code>apps/api/target/</code> 아래에 만들어 실행합니다.</p><div class="command" data-command-block><div class="command-header"><span>macOS / Linux</span><button type="button" data-copy-command aria-label="로컬 API 실행 명령 복사">복사</button></div><pre><code>{commands.api}</code></pre><p class="copy-status" aria-live="polite"></p></div><details><summary>Windows PowerShell 명령</summary><div class="command" data-command-block><div class="command-header"><span>PowerShell</span><button type="button" data-copy-command aria-label="Windows API 실행 명령 복사">복사</button></div><pre><code>{commands.apiWindows}</code></pre><p class="copy-status" aria-live="polite"></p></div></details><p class="caption">API: <code>http://127.0.0.1:8080</code><br />이 실행은 MariaDB 호환성 검증이 아닙니다.</p></div>
        <div class="step-card"><h3>터미널 B · 화면</h3><p>새 터미널도 저장소 루트에서 시작합니다. 개발 서버가 <code>/api</code> 요청을 로컬 API의 8080 포트로 전달합니다.</p><div class="command" data-command-block><div class="command-header"><span>macOS / Linux / Windows</span><button type="button" data-copy-command aria-label="화면 개발 서버 실행 명령 복사">복사</button></div><pre><code>{commands.web}</code></pre><p class="copy-status" aria-live="polite"></p></div><p class="caption">브라우저: <code>http://127.0.0.1:4321/</code><br /><code>npm ci</code>는 lockfile에 맞춰 설치합니다.</p></div>
      </div>
      <div class="learning-check"><h3>여기서 확인할 것</h3><ul><li>화면이 합성 예시 fallback이 아닌 <strong>실시간 API 응답</strong>을 표시하는지 확인합니다.</li><li><code>GET /api/demo/runs</code>와 단건 결과에서 입력 <strong>12 = 성공 7 + 실패 3 + 중복 2 + 대기 0</strong>을 확인합니다.</li><li>API를 끄면 연결 실패와 샘플 출처가 구분되는지 봅니다. 화면이 남아 있다고 서버가 정상인 것은 아닙니다.</li></ul><p>학습 질문: “브라우저가 데이터를 계산하는가, 저장된 서버 결과를 표시하는가?” 요청 경로와 응답의 출처를 설명할 수 있으면 다음 단계로 넘어갑니다.</p></div>
      <p class="source-links">실행 근거: <a href={source('apps/api/README.md')}>API README</a><a href={source('apps/lab-web/README.md')}>화면 README</a><a href={source('docs/contracts/demo-api.md')}>조회 API 계약</a></p>
    </section>

    <section id="expand" class="phase" aria-labelledby="stateful-heading">
      <div class="phase-heading"><span class="phase-number">02</span><div><p class="kicker">저장과 실행의 경계</p><h2 id="stateful-heading">DB를 붙이고, 재전달과 export를 이해합니다.</h2></div></div>
      <p>먼저 Docker Engine의 Linux 컨테이너·Compose와 Python 3을 준비해 <strong>MariaDB + API + Nginx 화면</strong>을 함께 실행합니다. 이 Compose에는 Kafka·Garage·상시 worker가 포함되지 않습니다.</p>
      <div class="command" data-command-block><div class="command-header"><span>저장소 루트 · 로컬 통합 환경</span><button type="button" data-copy-command aria-label="MariaDB 로컬 통합 실행 명령 복사">복사</button></div><pre><code>{commands.compose}</code></pre><p class="copy-status" aria-live="polite"></p></div>
      <p class="caption">환경에 따라 <code>python3</code> 대신 <code>python</code>을 사용합니다. <code>-p platform-lab-learning</code>은 학습용 Compose 프로젝트 이름입니다. 이미 사용 중인 이름은 피하고, 4310 포트가 겹치면 생성된 <code>.local/compose.env</code>의 <code>LAB_HTTP_PORT</code>를 비어 있는 포트로 변경합니다.</p>
      <div class="split">
        <div class="step-card"><h3>실행과 보존 확인</h3><p><code>http://127.0.0.1:4310/</code>에서 API의 DB 상세가 <strong>MariaDB</strong>인지 확인합니다. 비밀번호는 준비 스크립트가 <code>.local/compose.env</code>에 생성하고 기존 파일은 보존합니다.</p><p>일반 종료는 아래 명령입니다. named volume은 남습니다. <code>down -v</code>는 데이터 삭제이므로 이 안내의 종료 명령에 포함하지 않습니다.</p><div class="command" data-command-block><div class="command-header"><span>사용 후 종료</span><button type="button" data-copy-command aria-label="학습용 Compose 종료 명령 복사">복사</button></div><pre><code>{commands.stop}</code></pre><p class="copy-status" aria-live="polite"></p></div></div>
        <div class="step-card"><h3>Kafka·Garage는 다음 실험</h3><p>전체 처리 흐름은 <strong>입력 객체 → DB 작업·outbox → Kafka 포인터 → worker → 결과·실패 객체 → 저장 확인 → 슬롯 해제</strong>입니다.</p><p>Kafka는 작업 알림을 전달하고, Garage는 원본과 결과 파일을 저장하며, DB는 작업 상태와 실행 소유권을 기록합니다. 세 곳의 역할을 나누어 이해하는 것이 핵심입니다.</p><a class="text-link" href={source('docs/runbooks/continuous-runtime.md')}>상시 실행·재시작 실험 순서 ↗</a><a class="text-link" href={source('infra/charts/platform-lab/README.md')}>Kafka·Garage bootstrap 전제 ↗</a></div>
      </div>
      <div class="learning-check"><h3>메시징 실험을 시작하는 순서</h3><ol><li>새 전용 namespace·DB·저장소와 Secret을 준비하고 <strong>Kafka·Garage만 먼저</strong> 기동합니다.</li><li>topic·consumer group·bucket·키 권한을 준비합니다. API가 필요한 Flyway migration을 적용한 뒤 worker를 켭니다.</li><li>관리자용 내부 <code>--lab-runtime=stage</code>로 고정 합성 입력을 등록합니다. 공개 API에는 작업 생성 POST가 없습니다.</li><li>정상 수신뿐 아니라 중단 후 재전달, 결과·실패 파일의 전체 GET 검증, <code>EXPORTED</code> 상태와 슬롯 해제를 함께 확인합니다.</li></ol><p>학습 질문: “메시지를 두 번 받아도 결과가 중복되지 않는 이유는 무엇인가?” <a href={source('docs/evidence/kafka-redelivery/README.md')}>재전달 근거</a>와 <a href={source('docs/evidence/result-export/README.md')}>export 근거</a>에서 성공 조건과 실패 기록을 같이 읽습니다.</p></div>
      <p class="source-links">실행 근거: <a href={source('docs/runbooks/local-compose.md')}>Compose 실행 안내</a><a href={source('compose.yaml')}>실제 Compose 구성</a><a href={source('infra/scripts/prepare-local-env.py')}>로컬 비밀번호 준비 코드</a></p>
    </section>

    <section id="migrate" class="phase" aria-labelledby="delivery-heading">
      <div class="phase-heading"><span class="phase-number">03</span><div><p class="kicker">재현 가능한 배포</p><h2 id="delivery-heading">동작한 코드를 새 환경의 배포로 연결합니다.</h2></div></div>
      <p>권장 순서는 <strong>코드 검증 → 앱 이미지 게시 → 환경 설정 PR → Argo CD 동기화 → 실제 조회 확인</strong>입니다. Jenkins는 CI를, Argo CD는 배포 상태를 담당합니다. 같은 앱을 Jenkins의 <code>helm upgrade</code>로 동시에 관리하지 않습니다.</p>
      <div class="delivery-flow" aria-label="배포 단계"><span>소스 commit</span><b aria-hidden="true">→</b><span>CI + 이미지 digest</span><b aria-hidden="true">→</b><span>GitOps 설정</span><b aria-hidden="true">→</b><span>Argo CD + HTTP 확인</span></div>
      <h3>서버에 적용하기 전에, 렌더 결과부터 확인</h3>
      <p>Helm 4.3.0이 설치된 환경에서 아래 명령은 YAML을 검사·생성합니다. 클러스터에 리소스를 설치하지 않습니다. fixture의 <code>example.invalid</code> 이미지와 가짜 Secret은 <strong>문법 검사용</strong>이며 실제 배포 값이 아닙니다.</p>
      <div class="command" data-command-block><div class="command-header"><span>저장소 루트 · 설치 없는 Helm 검사</span><button type="button" data-copy-command aria-label="Helm 렌더 검사 명령 복사">복사</button></div><pre><code>{commands.render}</code></pre><p class="copy-status" aria-live="polite"></p></div>
      <h3>환경을 옮길 때 바꿔야 하는 것</h3>
      <div class="migration-list">{migrations.map((item, index) => <div class="migration-card"><span class="migration-index">{index + 1}</span><div><h4>{item.title}</h4><p>{item.detail}</p><ul class="file-list">{item.files.map((file) => <li><a href={source(file)}>{file}</a></li>)}</ul></div></div>)}</div>
      <div class="learning-check"><h3>“이식 완료”라고 말하기 위한 기준</h3><ul><li>CI가 검사한 source commit과 실제 앱 이미지 digest가 일치합니다.</li><li>Argo CD의 동기화뿐 아니라 Pod Ready·PVC Bound, 실제 GET 결과와 데이터 보존을 각각 확인합니다.</li><li>작업 실행을 옮긴다면 Kafka offset·DB 상태·객체 저장소를 함께 검증합니다. Pod가 떠 있다는 사실만으로 복구를 완료 처리하지 않습니다.</li><li>새 환경의 백업·복원·재시작·인증은 별도 검증 결과로 남깁니다. 기존 미니 PC의 성공 기록은 새 환경의 성공을 대신하지 않습니다.</li></ul></div>
      <p class="source-links">설정 근거: <a href={source('gitops/README.md')}>GitOps 역할</a><a href={source('Jenkinsfile')}>Jenkins 파이프라인</a><a href={source('docs/runbooks/image-publication.md')}>이미지 게시 절차</a><a href={source('infra/platform/versions.lock.json')}>플랫폼 버전 고정</a></p>
    </section>

    <section class="settings-section" aria-labelledby="settings-heading"><p class="kicker">설정 찾기</p><h2 id="settings-heading">어느 값을 어디서 바꾸나요?</h2><p>설정은 코드와 같이 검토하되, 비밀 값은 새 환경에서 별도로 관리합니다. 아래 값은 역할 안내이며 그대로 붙여 넣는 운영 설정 파일이 아닙니다.</p><div class="setting-list">{settings.map((setting) => <div class="setting-row"><div><h3>{setting.name}</h3><code>{setting.keys}</code></div><div><p>{setting.explanation}</p><a href={source(setting.file)}>{setting.file} ↗</a></div></div>)}</div></section>

    <section class="closing-note" aria-labelledby="reuse-heading"><p class="kicker">새 프로젝트에 가져갈 것</p><h2 id="reuse-heading">제품 이름보다 처리 원칙을 재사용하세요.</h2><p>DB 상태 전이, 작은 메시지 포인터, export 확인 후 슬롯 해제, 검증된 이미지의 GitOps 배포는 다른 프로젝트에서도 검토할 수 있는 설계입니다. 합성 센서 규칙·고정 입력·단일 노드 용량까지 그대로 제품 설계로 가져오지는 않습니다.</p><p>현재 chart는 개인 Lab의 단일 노드 구성을 명시적으로 제한합니다. 다른 시스템에서 한 번에 전체가 복제된다고 보장하는 설치 도구가 아니며, 다중 노드·외부 관리형 서비스는 별도 설계와 검증이 필요합니다.</p><details><summary>현재 프로젝트에서 계속 보류 중인 항목</summary><p>Pages 토큰 교체, 별도 환경의 K3s·Jenkins 실제 기동 복원, 자원 예산 정책, PR #102는 계속 보류합니다. 이 가이드는 해당 운영 작업을 재개하지 않습니다.</p></details><a class="return-link" href={`${base}technologies/`}>기술 목차에서 구성과 화면 다시 보기 <span aria-hidden="true">→</span></a></section>
  </article>
</GuideLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
    button.addEventListener('click', async () => {
      const block = button.closest('[data-command-block]');
      const code = block?.querySelector('code')?.textContent;
      const status = block?.querySelector<HTMLElement>('.copy-status');
      if (!code || !status) return;
      try {
        await navigator.clipboard.writeText(code);
        status.textContent = '명령을 복사했습니다. 실행 위치와 조건을 확인한 뒤 사용하세요.';
      } catch {
        status.textContent = '자동 복사가 되지 않았습니다. 위 명령을 직접 선택해 복사해주세요.';
      }
    });
  }
</script>

