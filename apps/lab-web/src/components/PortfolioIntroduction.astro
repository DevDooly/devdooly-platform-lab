---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const areas=[
  {n:'01',title:'서비스가 결과를 남기기까지',text:'입력 검증 → Kafka 전달 → worker 처리 → DB·S3 보존. 실패와 재수신을 다루는 설계를 읽습니다.',tags:'Java · Spring Boot · Kafka · MariaDB · Garage',path:'java'},
  {n:'02',title:'검증한 소스를 배포하기까지',text:'같은 소스의 CI 결과와 이미지, Git 선언을 연결합니다. Jenkins와 Argo CD의 책임을 나눕니다.',tags:'Jenkins · Actions · K3s · Helm · Argo CD',path:'jenkins'},
  {n:'03',title:'데이터를 다시 읽을 수 있도록',text:'별도 실험에서 테이블의 시점 조회와 파일 재작성 전후를 확인합니다. 행 보존과 파일 감소를 구분합니다.',tags:'Spark · Iceberg · Trino · S3',path:'lakehouse'},
];
---
<section id="portfolio-guide" class="section portfolio-intro" aria-labelledby="portfolio-guide-title">
  <div class="section-heading"><div><span class="eyebrow">READ THE DESIGN, THEN SEE IT WORK</span><h2 id="portfolio-guide-title">어떤 문제를, 어떤 기술로 풀었는지.</h2><p>업무에서 다룬 Java·데이터·플랫폼 기술을 개인 합성 예제로 연결했습니다.<br/>기술 설명에서 출발해 실제 화면과 소스, 재구축 방법까지 따라갈 수 있습니다.</p></div></div>
  <div class="portfolio-areas">{areas.map(area=><a href={`${base}technologies/${area.path}/`}><span>{area.n} / DESIGN STORY</span><h3>{area.title}</h3><p>{area.text}</p><strong>{area.tags}</strong><span class="area-link">설계와 화면 보기 →</span></a>)}</div>
  <div class="portfolio-paths"><a class="button button-primary" href={`${base}technologies/`}>8개 기술 전체 목차 →</a><a class="text-link" href={`${base}technologies/#architecture`}>전체 구성도</a><a class="text-link" href={`${base}guides/rebuild/`}>내 환경에 재구축하기</a><a class="text-link" href="#tour">실제 결과 5단계 관람</a></div>
</section>
<style>
.portfolio-intro{padding-top:36px;padding-bottom:52px;border-top:1px solid var(--line)}.portfolio-areas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.portfolio-areas>a{display:flex;flex-direction:column;align-items:flex-start;padding:25px;background:var(--surface);border:1px solid var(--line)}.portfolio-areas>a:hover{border-color:var(--green);background:#f0f5ed}.portfolio-areas span{font:.85rem var(--mono);color:var(--green);line-height:1.7}.portfolio-areas h3{font-size:1.35rem;margin:18px 0 14px}.portfolio-areas p{color:var(--muted);margin-bottom:22px;line-height:1.85}.portfolio-areas strong{font-size:.95rem;font-weight:500;margin-top:auto}.portfolio-areas .area-link{font-family:var(--sans);font-weight:600;font-size:1rem;margin-top:20px}.portfolio-paths{display:flex;align-items:center;flex-wrap:wrap;gap:22px;margin-top:30px}@media(max-width:800px){.portfolio-areas{grid-template-columns:1fr}.portfolio-areas>a{padding:23px}.portfolio-paths{gap:20px}}
</style>
