    "validate:observation": "node --experimental-strip-types scripts/validate-observation.ts"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@astrojs/react": "7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "oxc-transform-react": "0.145.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.1.1"
  }
}
