{
  "name": "@devdooly/platform-lab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
