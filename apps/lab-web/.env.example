# Public browser address only. Never put credentials here.
# Default: same-origin /api (Nginx proxy in production).
PUBLIC_API_BASE_URL=/api
# Development proxy only; browser still requests /api.
API_PROXY_TARGET=http://127.0.0.1:8080

# Static publication only. Defaults suit same-host container deployment.
# SITE_URL=https://devdooly.github.io
# SITE_BASE=/devdooly-platform-lab/
