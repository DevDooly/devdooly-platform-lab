[Unit]
Description=Capture public platform observation and request Pages publication
After=network-online.target k3s.service
Wants=network-online.target
ConditionPathExists=/etc/devdooly-platform-lab/observer.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/devdooly-platform-lab/observer.env
ExecStart=/usr/bin/python3 -B /opt/devdooly-platform-lab/observation/host_cycle.py --config ${OBSERVER_CONFIG_FILE}
UMask=0077
StateDirectory=devdooly-platform-observer
StateDirectoryMode=0700
RuntimeDirectory=devdooly-platform-observer
RuntimeDirectoryMode=0700
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/devdooly-platform-observer /run/devdooly-platform-observer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
StandardOutput=journal
StandardError=null
# Preparation only: there is intentionally no service [Install] target.
